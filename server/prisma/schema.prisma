generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                @id @default(autoincrement())
  mobile               String             @unique
  name                 String
  password             String             @default("123456")
  designation          String?
  role                 String             @default("ENGINEER")
  failed_attempt_count Int                @default(0)
  is_active            Boolean            @default(true)
  locked_at            DateTime?
  last_failed_login_at DateTime?
  isDeleted            Boolean            @default(false)
  logs                 AuditLog[]
  directions           ProjectDirection[]
  updates              ProjectUpdate[]
}

model Project {
  id                       Int                @id @default(autoincrement())
  name                     String             @unique
  type                     ProjectType
  consultancySource        String?            @default("NIT")
  brief                    String             @default("")
  fundingAgency            String
  estimatedCost            Float
  inchargeName             String
  inchargeMobile           String
  consultantName           String?
  consultantMobile         String?
  contractorName           String?
  contractorMobile         String?
  actualStartDate          DateTime?
  stipulatedCompletionDate DateTime?
  workStarted              String             @default("No")
  delayReasons             String?
  delayBrief               String?
  overallStatus            String             @default("On Track")
  statusHoldReason         String?
  statusDelayReasons       String?
  statusDelayBrief         String?
  todaysUpdateNote         String?            @default("")
  qualitySampling          String?            @default("No")
  qualitySamplingReason    String?            @default("")
  expectedCompletionDate   DateTime?
  timeExtension            String?
  status                   String             @default("ONGOING")
  isLegacy                 Boolean            @default(false)
  currentProgress          Float              @default(0)
  gpsLat                   Float?
  gpsLong                  Float?
  configVersionId          Int?
  fieldData                String?
  stageData                String?
  bidTechEvalDate          DateTime?
  bidTechEvalCompleted     String?            @default("No")
  bidTechEvalDelayReason   String?
  bidFinEvalDate           DateTime?
  bidFinEvalCompleted      String?            @default("No")
  bidFinEvalDelayReason    String?
  isDeleted                Boolean            @default(false)
  deletedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  auditLogs                AuditLog[]
  pertActivities           PertActivity[]
  configVersion            ConfigVersion?     @relation(fields: [configVersionId], references: [id])
  directions               ProjectDirection[]
  updates                  ProjectUpdate[]
  workflows                ProjectWorkflow[]
}

model ConfigVersion {
  id            Int            @id @default(autoincrement())
  versionNumber Int            @unique
  createdAt     DateTime       @default(now())
  createdBy     Int
  isActive      Boolean        @default(false)
  projects      Project[]
  fields        ProjectField[]
  stages        ProjectStage[]
}

model ProjectStage {
  id            Int           @id @default(autoincrement())
  stageKey      String
  displayName   String
  sequenceOrder Int
  isActive      Boolean       @default(true)
  versionId     Int
  version       ConfigVersion @relation(fields: [versionId], references: [id])
}

model ProjectField {
  id            Int           @id @default(autoincrement())
  fieldKey      String
  displayName   String
  fieldType     String
  isRequired    Boolean       @default(false)
  isActive      Boolean       @default(true)
  location      String        @default("MASTER")
  sequenceOrder Int           @default(0)
  versionId     Int
  version       ConfigVersion @relation(fields: [versionId], references: [id])
}

model ProjectDirection {
  id        Int      @id @default(autoincrement())
  direction String
  timestamp DateTime @default(now())
  projectId Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
}

model ProjectWorkflow {
  id          Int       @id @default(autoincrement())
  stageKey    String
  stepName    String
  isCompleted Boolean   @default(false)
  date        DateTime?
  value       String?
  reason      String?
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])

  @@unique([projectId, stageKey])
}

model PertActivity {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  weightage Float
  startDate DateTime
  endDate   DateTime
  progress  Float    @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model ProjectUpdate {
  id                     Int       @id @default(autoincrement())
  projectId              Int
  userId                 Int
  physicalProgress       Float
  financialProgress      Float
  gpsLat                 Float?
  gpsLong                Float?
  photos                 String
  remarks                String
  timestamp              DateTime  @default(now())
  expectedCompletionDate DateTime?
  overallStatus          String?
  qualitySampling        String?   @default("No")
  qualitySamplingReason  String?   @default("")
  statusDelayBrief       String?
  statusDelayReasons     String?
  statusHoldReason       String?
  timeExtension          String?
  todaysUpdateNote       String?
  fieldData              String?
  user                   User      @relation(fields: [userId], references: [id])
  project                Project   @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  projectId Int?
  userId    Int
  action    String
  details   String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
}

enum Role {
  ADMIN
  DEO
  ENGINEER
  VIEWER
}

enum ProjectType {
  EXECUTION
  CONSULTANCY
}

enum ProjectStatus {
  ONGOING
  COMPLETED
}
